muinit = c(mean(V2[,1]),0,0,0), siginit = sqrt(var(V2[,1])), shinit = -0.001, show = T,
method = "Nelder-Mead", maxit = 10000)

mod5=rlarg.fit(V2, r = 10, ydat = matrix(c((1:51),cos(2*pi*(1:51)/11),sin(2*pi*(1:51)/11)),ncol=3), mul = 1:3, sigl = NULL, shl = NULL, mulink = identity, siglink = identity, shlink = identity,
muinit = c(mean(V2[,1]),0,0,0), siginit = sqrt(var(V2[,1])), shinit = -0.001, show = T,
method = "Nelder-Mead", maxit = 10000)

# code to compare predictions under models 2, 3, 5

fit2=matrix(c(rep(1,51),(1:51),rep(0,51),rep(0,51)),ncol=4) %*% mod2$mle+
(mod2$mle[3]*(log(2)^(-mod2$mle[4])-1)/mod2$mle[4])
fit3=matrix(c(rep(1,51),(1:51),(1:51)^2,rep(0,51),rep(0,51)),ncol=5) %*% mod3$mle+
(mod3$mle[4]*(log(2)^(-mod3$mle[5])-1)/mod3$mle[5])
fit5=matrix(c(rep(1,51),(1:51),cos(2*pi*(1:51)/11),sin(2*pi*(1:51)/11),rep(0,51),rep(0,51)),ncol=6)%*% mod5$mle+
(mod5$mle[5]*(log(2)^(-mod5$mle[6])-1)/mod5$mle[6])


tab1=round(cbind(mod2$mle,mod2$se,mod2$mle/mod2$se,2*pnorm(-abs(mod2$mle/mod2$se))),4)
tab2=cbind(rep('&',4),tab1[,1],rep('&',4),tab1[,2],rep('&',4),tab1[,3],rep('&',4),tab1[,4],rep('&',4))

c(mod1$nllh,mod2$nllh,mod3$nllh,mod4$nllh,mod5$nllh)

# likelihood ratio tests to compare models
D1=2*(mod1$nllh-mod2$nllh)
